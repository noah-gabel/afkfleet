# afkfleet's host settings (Plan.md P12.2; ADR-0022, U18). Copy this file to
# .env in this folder (cp env.example .env) and fill it in. .env stays on this
# host: it's never in the repository, and an update never replaces it. Every
# setting you change goes here, never into a file of the release.
#
# Lines starting AFKFLEET_SERVER__ or AFKFLEET_AGENT__ go to the server's or
# the agent's config and override deploy/prod/'s keys; an unknown one stops
# the start, so a typo shows. The other lines are compose's own. Keep each
# comment on a line of its own: a value is read up to the end of its line.

# --- The proxy path: keep one COMPOSE_FILE line ---
# Append :compose.grpc.yaml for remote agents, and :compose.override.yaml for
# a host-only override file of your own. `sh setup.sh check` says whether 80
# and 443 are free here.
# afkfleet's own Caddy on 80 and 443:
COMPOSE_FILE=compose.yaml:compose.edge.yaml:compose.caddy.yaml
# An existing reverse proxy in a container, which joins afkfleet_edge at
# AFKFLEET_PROXY_ADDRESS:
#COMPOSE_FILE=compose.yaml:compose.edge.yaml
# An existing reverse proxy on this host, which connects to
# 127.0.0.1:AFKFLEET_HTTP_PORT:
#COMPOSE_FILE=compose.yaml:compose.loopback.yaml

# --- The images ---
# A release's files name its own images, pinned by their digests (RELEASE).
# Set these only to run other images, such as the two `just images` builds:
#AFKFLEET_SERVER_IMAGE=afkfleet-server:dev
#AFKFLEET_AGENT_IMAGE=afkfleet-agent:dev

# --- Caddy's path ---
# The domain that points at this host, and the email of its Let's Encrypt
# account (both stay on this host).
AFKFLEET_DOMAIN=fleet.example.com
AFKFLEET_TLS=letsencrypt
AFKFLEET_ACME_EMAIL=admin@example.com

# --- The other proxy paths ---
# The proxy's own address on afkfleet_edge, the one the server trusts:
#AFKFLEET_PROXY_ADDRESS=172.30.1.2
# The loopback port a proxy on this host connects to:
#AFKFLEET_HTTP_PORT=8080

# --- Remote agents (with compose.grpc.yaml) ---
# The published gRPC port, or an address and port (192.0.2.10:7443):
#AFKFLEET_GRPC_PUBLISH=7443
# The names and addresses remote agents dial, comma-separated, for the
# server's certificate (setup.sh adds `server`, which the local agent dials):
#AFKFLEET_GRPC_NAMES=fleet.example.com

# --- The backups' host folder: 65532's, mode 700, read by the SFTP account ---
#AFKFLEET_BACKUPS_DIR=/srv/afkfleet-backups/backups

# --- The networks ---
# Change a subnet only if `up` says "Pool overlaps": another network on this
# host has it. The server's address stays inside its subnet, below the range.
#AFKFLEET_FLEET_SUBNET=172.30.0.0/24
#AFKFLEET_FLEET_GATEWAY=172.30.0.1
#AFKFLEET_FLEET_RANGE=172.30.0.128/25
#AFKFLEET_SERVER_FLEET_ADDRESS=172.30.0.10
#AFKFLEET_EDGE_SUBNET=172.30.1.0/24
#AFKFLEET_EDGE_GATEWAY=172.30.1.1
#AFKFLEET_EDGE_RANGE=172.30.1.128/25

# --- The limits (memory without swap) ---
#AFKFLEET_SERVER_MEMORY=512m
#AFKFLEET_SERVER_CPUS=1.0
#AFKFLEET_SERVER_PIDS=256
# About 64 MiB plus 8 MiB per bot:
#AFKFLEET_AGENT_MEMORY=512m
#AFKFLEET_AGENT_CPUS=1.0
#AFKFLEET_AGENT_PIDS=512
#AFKFLEET_CADDY_MEMORY=256m
#AFKFLEET_CADDY_CPUS=0.5
#AFKFLEET_CADDY_PIDS=128

# --- The server's settings the runbook names ---
#AFKFLEET_SERVER__DATABASE__BACKUP_KEEP=14
#AFKFLEET_SERVER__DATABASE__BACKUP_INTERVAL_HOURS=24
#AFKFLEET_SERVER__CHAT__RETENTION_DAYS=14
#AFKFLEET_SERVER__CHAT__MAX_LINES_PER_BOT=50000
# A vault key rotation's new key, and then the active one:
#AFKFLEET_SERVER__VAULT__MASTER_KEY_FILES__2=/keys/vault-key-2
#AFKFLEET_SERVER__VAULT__ACTIVE_KEY_ID=2

# --- The agent's settings ---
# U50 for production (ADR-0022, U10): false stops all public dialling at the
# agent's next start (docker compose up -d agent).
AFKFLEET_AGENT__CONTROL_PLANE__PUBLIC_TARGETS=true
# Private networks the bots may dial, e.g. a Minecraft server's beside them,
# each a CIDR network inside a private range (none by default, U10):
#AFKFLEET_AGENT__CONTROL_PLANE__PRIVATE_TARGETS=["<network>/<prefix>"]
#AFKFLEET_AGENT__RUNTIME__MAX_BOTS=50
