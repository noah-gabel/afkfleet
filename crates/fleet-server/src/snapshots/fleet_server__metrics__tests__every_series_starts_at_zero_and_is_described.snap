---
source: crates/fleet-server/src/metrics.rs
expression: sorted(&render)
---
# HELP afkfleet_agent_certificate_renewals_total Agents' certificates the server renewed.
# TYPE afkfleet_agent_certificate_renewals_total counter
afkfleet_agent_certificate_renewals_total 0

# HELP afkfleet_agent_certificates Enabled agents whose latest certificate ends soon (expiring: its last 14 days, though an agent renews with a third of its lifetime left) or has ended (expired: it must enroll again).
# TYPE afkfleet_agent_certificates gauge
afkfleet_agent_certificates{state="expired"} 0
afkfleet_agent_certificates{state="expiring"} 0

# HELP afkfleet_agent_connects_refused_total Agent connections refused for their certificate, by reason, past the audit log's daily cap too.
# TYPE afkfleet_agent_connects_refused_total counter
afkfleet_agent_connects_refused_total{reason="already_connected"} 0
afkfleet_agent_connects_refused_total{reason="disabled"} 0
afkfleet_agent_connects_refused_total{reason="expired"} 0
afkfleet_agent_connects_refused_total{reason="name_mismatch"} 0
afkfleet_agent_connects_refused_total{reason="no_certificate"} 0
afkfleet_agent_connects_refused_total{reason="revoked"} 0
afkfleet_agent_connects_refused_total{reason="san_mismatch"} 0
afkfleet_agent_connects_refused_total{reason="unknown_certificate"} 0

# HELP afkfleet_agent_identity_conflicts_total Times two processes were found holding one agent's identity.
# TYPE afkfleet_agent_identity_conflicts_total counter
afkfleet_agent_identity_conflicts_total 0

# HELP afkfleet_agent_reports_dropped_total Agent reports about bots the agent doesn't hold, dropped.
# TYPE afkfleet_agent_reports_dropped_total counter
afkfleet_agent_reports_dropped_total 0

# HELP afkfleet_backup_failures_total Scheduled backups that failed, or whose folder couldn't be read.
# TYPE afkfleet_backup_failures_total counter
afkfleet_backup_failures_total 0

# HELP afkfleet_backup_last_duration_seconds How long the last scheduled backup took, in seconds.
# TYPE afkfleet_backup_last_duration_seconds gauge
afkfleet_backup_last_duration_seconds 0

# HELP afkfleet_backup_last_size_bytes How large the last scheduled backup is, in bytes.
# TYPE afkfleet_backup_last_size_bytes gauge
afkfleet_backup_last_size_bytes 0

# HELP afkfleet_backup_last_success_timestamp_seconds When the newest finished backup in [database] backup_dir was taken, in Unix seconds, the backup command's included; 0 without one.
# TYPE afkfleet_backup_last_success_timestamp_seconds gauge
afkfleet_backup_last_success_timestamp_seconds 0

# HELP afkfleet_backup_prune_failures_total Scheduled backups written whose pruning of older backups failed.
# TYPE afkfleet_backup_prune_failures_total counter
afkfleet_backup_prune_failures_total 0

# HELP afkfleet_ingest_chat_dropped_total Chat lines from agents the ingest didn't take, by reason.
# TYPE afkfleet_ingest_chat_dropped_total counter
afkfleet_ingest_chat_dropped_total{reason="closed"} 0
afkfleet_ingest_chat_dropped_total{reason="queue_full"} 0
afkfleet_ingest_chat_dropped_total{reason="stream_full"} 0

# HELP afkfleet_ingest_rows_total Chat rows the ingest's batches stored, skipped (their bot is assigned elsewhere) or lost (a batch that failed).
# TYPE afkfleet_ingest_rows_total counter
afkfleet_ingest_rows_total{outcome="lost"} 0
afkfleet_ingest_rows_total{outcome="skipped"} 0
afkfleet_ingest_rows_total{outcome="stored"} 0

# HELP afkfleet_login_lockout_refusals_total Logins the per-username lockout refused, by reason.
