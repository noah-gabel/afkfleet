# HELP afkfleet_refresh_token_reuses_total Refresh tokens presented again after their rotation: each revoked its session. Any is a possible token theft.
# TYPE afkfleet_refresh_token_reuses_total counter
afkfleet_refresh_token_reuses_total 0

# HELP afkfleet_retention_last_run_batches How many batches the last retention run committed.
# TYPE afkfleet_retention_last_run_batches gauge
afkfleet_retention_last_run_batches 0

# HELP afkfleet_retention_last_run_duration_seconds How long the last retention run took, in seconds.
# TYPE afkfleet_retention_last_run_duration_seconds gauge
afkfleet_retention_last_run_duration_seconds 0

# HELP afkfleet_retention_last_success_timestamp_seconds When the last successful retention run ended, in Unix seconds; 0 until the first. The retention isn't watched: an old value means it died or fails every run.
# TYPE afkfleet_retention_last_success_timestamp_seconds gauge
afkfleet_retention_last_success_timestamp_seconds 0

