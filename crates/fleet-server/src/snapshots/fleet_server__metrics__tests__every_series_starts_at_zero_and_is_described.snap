# HELP afkfleet_server_certificate_not_after_timestamp_seconds When the gRPC port's server certificate ends, in Unix seconds; 0 without [grpc]. After it no agent can connect: renew it with pki server-cert before.
# TYPE afkfleet_server_certificate_not_after_timestamp_seconds gauge
afkfleet_server_certificate_not_after_timestamp_seconds 0

