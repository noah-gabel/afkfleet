  "query": "SELECT rowid AS \"rowid!: i64\", id AS \"id!\", name AS \"name!\"\n           FROM modes\n           WHERE EXISTS (\n               SELECT 1 FROM json_each(modes.definition_json, '$.steps') AS step\n               WHERE json_extract(step.value, '$.action.type') = 'enter_minecart'\n           )\n           ORDER BY name, id",
