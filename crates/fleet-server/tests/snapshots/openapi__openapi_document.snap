        "required": [
          "recovery_codes"
        ],
        "type": "object"
      },
      "MfaEnrollResponse": {
        "description": "`POST /me/mfa/enroll`: a new TOTP secret for the authenticator app.\nEach call replaces the pending one; nothing is stored until confirm.",
        "properties": {
