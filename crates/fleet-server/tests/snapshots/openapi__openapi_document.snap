        "description": "What an invite is now.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "pending",
          "used",
          "revoked",
          "expired"
        ],
        "type": "string"
      },
      "LastDisconnect": {
        "description": "How a bot's last session ended. A kick's key and message come from the\nMinecraft server: cleaned and capped, and shown as plain text.",
        "properties": {
