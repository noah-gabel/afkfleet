              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A `limit` outside 1 to 100."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again.",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "`GET /api/v1/users`: one page of users, newest first.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/users/{id}": {
      "patch": {
        "operationId": "patch_user",
        "parameters": [
          {
            "description": "The user's ID.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "The user after the change."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A body of the wrong shape."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid access token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Step up first: `POST /auth/step-up`; or the change isn't the caller's to make."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such user, or one the caller can't see."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not exactly one of `role` and `disabled`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again.",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "`PATCH /api/v1/users/{id}`: one change, a role or `disabled`; either\nends every session of the user. Needs a step-up.",
        "tags": [
          "users"
        ],
        "x-step-up": true
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live",
        "responses": {
          "200": {
            "description": "The server runs and answers requests. The body is empty."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "summary": "`GET /health/live`: the process runs and answers requests. It checks\nnothing else, so it never fails while the server can answer at all.",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "The database answers. The body is empty."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database failed; the server's log holds the cause under the request ID."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database is busy.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again: always 1.",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "summary": "`GET /health/ready`: the server can serve requests, which means the\ndatabase answers.",
        "tags": [
          "health"
        ]
      }
    }
  }
}
