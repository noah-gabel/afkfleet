          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LinkFlowState": {
        "description": "Where a link flow stands.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
