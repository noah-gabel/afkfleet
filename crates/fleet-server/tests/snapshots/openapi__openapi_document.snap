---
source: crates/fleet-server/tests/openapi.rs
expression: answer.json()
---
{
  "components": {
    "schemas": {
      "CreateInviteRequest": {
        "additionalProperties": false,
        "description": "`POST /invites`: a new invite for `role`.",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The role the new user gets: `member` (Admins and the Owner) or\n`admin` (the Owner only)."
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "CreatedInviteResponse": {
        "description": "The new invite, with its code: shown this once.",
        "properties": {
          "code": {
            "maxLength": 64,
            "type": "string"
          },
          "invite": {
            "$ref": "#/components/schemas/InviteResponse",
            "description": "The invite as `GET /invites` lists it."
          }
        },
        "required": [
          "code",
          "invite"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "What went wrong, for the caller.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "What went wrong."
          },
          "fields": {
            "description": "Every broken rule; only for `validation_failed`.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "message": {
            "maxLength": 256,
            "type": "string"
          },
          "request_id": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "What went wrong with a request.\nThis union lists the codes this version knows; a newer server may send\nothers, so code that branches on a code always keeps a default branch that\nshows the message and the request ID.",
        "enum": [
          "bad_request",
          "unauthorized",
          "invalid_credentials",
          "forbidden",
          "step_up_required",
          "not_found",
          "method_not_allowed",
          "timeout",
          "conflict",
          "payload_too_large",
          "unsupported_media_type",
          "validation_failed",
          "rate_limited",
          "internal",
          "busy"
        ],
        "type": "string"
      },
      "ErrorResponse": {
        "description": "The body of every error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "The error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FailedCodeAttempts": {
        "description": "The wrong 2FA codes typed for the user after their previous successful\nlogin: what happened since they last logged in. The wrong codes of the\nnewest login's own step, the user's typos before it succeeded, aren't\ncounted, so a count above 0 means a login step that never succeeded.",
        "properties": {
          "count": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "last_at": {
            "maxLength": 24,
            "type": "string"
          }
        },
        "required": [
          "count"
        ],
        "type": "object"
      },
      "FieldError": {
        "description": "A field that broke a rule.",
        "properties": {
          "message": {
            "maxLength": 256,
            "type": "string"
          },
          "path": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "type": "object"
      },
      "InvitePage": {
        "description": "`GET /invites`: one page of invites, newest first, in every state.",
        "properties": {
          "items": {
            "description": "The invites.",
            "items": {
              "$ref": "#/components/schemas/InviteResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "InviteResponse": {
        "description": "An invite as `GET /invites` lists it.",
        "properties": {
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "created_by": {
            "$ref": "#/components/schemas/UserLabel",
            "description": "Who created it."
          },
          "expires_at": {
            "maxLength": 24,
            "type": "string"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "revoked_at": {
            "maxLength": 24,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The role the new user gets."
          },
          "state": {
            "$ref": "#/components/schemas/InviteState",
            "description": "What it is now."
          },
          "used_at": {
            "maxLength": 24,
            "type": "string"
          },
          "used_by": {
            "$ref": "#/components/schemas/UserLabel",
            "description": "The user it registered, once used."
          }
        },
        "required": [
          "id",
          "role",
          "state",
          "created_by",
          "created_at",
          "expires_at"
        ],
        "type": "object"
      },
      "InviteState": {
        "description": "What an invite is now.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "pending",
          "used",
          "revoked",
          "expired"
        ],
        "type": "string"
      },
      "LoginMfaRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/login/mfa`: the code step.",
        "properties": {
          "code": {
            "maxLength": 64,
            "type": "string"
          },
          "mfa_token": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "mfa_token",
          "code"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/login`: the password step.",
        "properties": {
          "password": {
            "maxLength": 1024,
            "type": "string"
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "description": "The password step's answer: never real tokens.",
        "properties": {
          "expires_in": {
            "maximum": 600,
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/LoginStatus",
            "description": "What comes next."
          },
          "token": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "status",
          "token",
          "expires_in"
        ],
        "type": "object"
      },
      "LoginStatus": {
        "description": "What the password step leads to.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "mfa_required",
          "mfa_setup_required"
        ],
        "type": "string"
      },
      "MeResponse": {
        "description": "`GET /me`: the user's profile and security facts.",
        "properties": {
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "failed_code_attempts": {
            "$ref": "#/components/schemas/FailedCodeAttempts",
            "description": "The wrong 2FA codes since the previous login, without the newest\nlogin's own typos."
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "mfa_confirmed_at": {
            "maxLength": 24,
            "type": "string"
          },
          "password_changed_at": {
            "maxLength": 24,
            "type": "string"
          },
          "recovery_codes_left": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The global role."
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "created_at",
          "password_changed_at",
          "recovery_codes_left",
          "failed_code_attempts"
        ],
        "type": "object"
      },
      "MfaConfirmRequest": {
        "additionalProperties": false,
        "description": "`POST /me/mfa/confirm`: the first code the authenticator app shows, which\nproves it holds the secret.",
        "properties": {
          "code": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "MfaConfirmResponse": {
        "description": "The confirmed authenticator's recovery codes: shown once, each usable\nonce instead of a code from the app.",
        "properties": {
          "recovery_codes": {
            "items": {
              "maxLength": 24,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "recovery_codes"
        ],
        "type": "object"
      },
      "MfaEnrollResponse": {
        "description": "`POST /me/mfa/enroll`: a new TOTP secret for the authenticator app.\nEach call replaces the pending one; nothing is stored until confirm.",
        "properties": {
          "otpauth_uri": {
            "maxLength": 256,
            "type": "string"
          },
          "qr_svg": {
            "maxLength": 32768,
            "type": "string"
          },
          "secret": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "otpauth_uri",
          "qr_svg",
          "secret"
        ],
        "type": "object"
      },
      "MfaResetResponse": {
        "description": "`POST /me/mfa/reset`: a setup token for replacing the authenticator.\nUntil confirm, the current one keeps working.",
        "properties": {
          "expires_in": {
            "maximum": 600,
            "minimum": 0,
            "type": "integer"
          },
          "setup_token": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "setup_token",
          "expires_in"
        ],
        "type": "object"
      },
      "PasswordChangeRequest": {
        "additionalProperties": false,
        "description": "`POST /me/password`: a new password, after stepping up. Every other\nsession of the user ends, and so does this session's step-up.",
        "properties": {
          "new_password": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "new_password"
        ],
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/refresh`: a new token pair for the refresh token.",
        "properties": {
          "refresh_token": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/register`: an account from an invite. The invite decides\nthe role; the account has no 2FA until its first login's setup.",
        "properties": {
          "invite": {
            "maxLength": 64,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "type": "string"
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "invite",
          "username",
          "password"
        ],
        "type": "object"
      },
      "RegisterResponse": {
        "description": "The new account: log in with it next, and set up 2FA there.",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The role the invite gave."
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "SessionPage": {
        "description": "`GET /me/sessions`: one page of live sessions, newest first.",
        "properties": {
          "items": {
            "description": "The sessions.",
            "items": {
              "$ref": "#/components/schemas/SessionResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "description": "A live session: not ended, and its refresh token not expired.",
        "properties": {
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "current": {
            "description": "Whether it's the session of this request.",
            "type": "boolean"
          },
          "expires_at": {
            "maxLength": 24,
            "type": "string"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "last_used_at": {
            "maxLength": 24,
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "last_used_at",
          "expires_at",
          "current"
        ],
        "type": "object"
      },
      "StepUpRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/step-up`: the password again, which allows step-up actions\nin this session for 5 minutes.",
        "properties": {
          "password": {
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "description": "A session's tokens: the code step's and a refresh's answer.",
        "properties": {
          "access_expires_in": {
            "maximum": 3600,
            "minimum": 0,
            "type": "integer"
          },
          "access_token": {
            "maxLength": 64,
            "type": "string"
          },
          "refresh_expires_in": {
            "maximum": 31536000,
            "minimum": 0,
            "type": "integer"
          },
          "refresh_token": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "access_expires_in",
          "refresh_expires_in"
        ],
        "type": "object"
      },
      "UserLabel": {
        "description": "A user named next to something else, such as an invite's creator.",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "type": "object"
      },
      "UserPage": {
        "description": "`GET /users`: one page of users, newest first.",
        "properties": {
          "items": {
            "description": "The users.",
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "UserPatchRequest": {
        "additionalProperties": false,
        "description": "`PATCH /users/{id}`: exactly one change, a role or `disabled`.",
        "properties": {
          "disabled": {
            "description": "Whether the user is disabled. Changing it, or the role, ends every\nsession of the user.",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The new role: `member` or `admin`, and only the Owner changes it."
          }
        },
        "type": "object"
      },
      "UserResponse": {
        "description": "A user as `GET /users` lists them, and as `PATCH /users/{id}` answers.",
        "properties": {
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "disabled": {
            "description": "Whether the user is disabled: they can't log in, and every request\nof theirs is refused.",
            "type": "boolean"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "last_seen_at": {
            "maxLength": 24,
            "type": "string"
          },
          "mfa_enrolled": {
            "description": "Whether the user has confirmed an authenticator. An invitee who never\nfinished the 2FA setup has none, and whoever first enrolls with their\npassword owns the account: disable such an account.",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The global role."
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "disabled",
          "created_at",
          "mfa_enrolled"
        ],
        "type": "object"
      },
      "UserRole": {
        "description": "A user's global role.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "member",
          "admin",
          "owner"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "access_token": {
        "scheme": "bearer",
        "type": "http"
      },
      "setup_token": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The afkfleet server's HTTP API. Served only in dev mode.",
    "license": {
      "identifier": "GPL-3.0-or-later",
      "name": "GPL-3.0-or-later"
    },
    "title": "afkfleet",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "An mfa token for the code step, or a setup token for enrolling first."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The username or the password is wrong; nothing tells which."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The username isn't a valid one, or the password is too long."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many logins from this address, or the username is locked.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again.",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "summary": "`POST /api/v1/auth/login`: the password step; never real tokens.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login/mfa": {
      "post": {
        "operationId": "login_mfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginMfaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "The session's tokens."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The code is wrong, or the mfa token is no longer valid; nothing tells which."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The code is neither 6 digits nor a recovery code, or a field is too long."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many logins from this address, or the username is locked.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again.",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "summary": "`POST /api/v1/auth/login/mfa`: the code step; the session's tokens.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "The session is over."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid access token."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "`POST /api/v1/auth/logout`: ends this session.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "The session's new tokens; the old ones stop working."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The session is over: log in again."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The token field is too long."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
