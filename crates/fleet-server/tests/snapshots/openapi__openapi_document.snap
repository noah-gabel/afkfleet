          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid access token."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No live session of the user's with this ID."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "It's this request's session: log out instead."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again.",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "`DELETE /api/v1/me/sessions/{id}`: ends another session of the user's.",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "list_users",
        "parameters": [
          {
            "description": "Only items older than this ID: the `next` of the page before.",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "maxLength": 36,
              "type": "string"
            }
          },
          {
            "description": "How many items at most; 50 by default.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
