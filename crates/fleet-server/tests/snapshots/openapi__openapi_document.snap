        ],
        "type": "object"
      },
      "ModeAction": {
        "description": "A step's action as its viewer may see it: its `type` and the fields that\ntype takes.",
        "properties": {
          "arguments_hidden": {
            "description": "Whether a command's arguments were left out for this viewer (S15).",
            "type": "boolean"
          },
          "max_pitch": {
            "maximum": 90,
            "minimum": 0,
            "type": "number"
          },
          "max_yaw": {
            "maximum": 180,
            "minimum": 0,
            "type": "number"
          },
          "message": {
            "maxLength": 256,
            "type": "string"
          },
          "on": {
            "description": "`sneak` and `hold_use`: start or stop.",
            "type": "boolean"
          },
          "pitch": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "slot": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/ModeActionKind",
            "description": "What it does."
          },
          "yaw": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          }
        },
        "required": [
          "type",
          "arguments_hidden"
        ],
        "type": "object"
      },
      "ModeActionKind": {
        "description": "What a step does: its action's `type` (ADR-0010).\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "look",
          "rotate_random",
          "jump",
          "sneak",
          "swing_arm",
          "use_item",
          "hold_use",
          "attack_facing_entity",
          "select_hotbar_slot",
          "send_chat"
        ],
        "type": "string"
      },
      "ModeActionRequest": {
        "additionalProperties": false,
        "description": "A step's action in a request: its `type` and the fields that type takes,\nno others (see `ModeActionKind`).",
        "properties": {
          "max_pitch": {
            "maximum": 90,
            "minimum": 0,
            "type": "number"
          },
          "max_yaw": {
            "maximum": 180,
            "minimum": 0,
            "type": "number"
          },
          "message": {
            "maxLength": 256,
            "type": "string"
          },
          "on": {
            "description": "`sneak` and `hold_use`: start (true) or stop.",
            "type": "boolean"
          },
          "pitch": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "slot": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/ModeActionKind",
            "description": "What it does."
          },
          "yaw": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "ModeOwnership": {
        "description": "Whose a mode is, as every viewer may know it (S14): who exactly owns\nsomeone else's is the mode's `owner`, for Admins and the Owner only.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "built_in",
          "mine",
          "someone_else"
        ],
        "type": "string"
      },
      "ModePage": {
        "description": "`GET /modes`: one page of the modes the caller may see, newest first.",
        "properties": {
          "items": {
            "description": "The modes.",
            "items": {
              "$ref": "#/components/schemas/ModeResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ModeResponse": {
        "description": "A mode as its viewer may see it (S14, S15).",
        "properties": {
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "deletable": {
            "description": "Whether the viewer may delete it.",
            "type": "boolean"
          },
          "editable": {
            "description": "Whether the viewer may change its name and steps.",
            "type": "boolean"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "name": {
            "maxLength": 32,
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/UserLabel",
            "description": "Who owns it: for Admins and the Owner only (S14)."
          },
          "ownership": {
            "$ref": "#/components/schemas/ModeOwnership",
            "description": "Whose it is, as far as every viewer may know: built in, the\nviewer's, or someone else's (S14)."
          },
          "steps": {
            "description": "Its steps. A viewer who may not edit it sees each command a chat\nstep sends as its `/` and name alone (S15).",
            "items": {
              "$ref": "#/components/schemas/ModeStep"
            },
            "type": "array"
          },
          "unlisted_command": {
            "description": "Whether one of its chat steps sends a command off the server's\nallowlist, so choosing it for a bot needs Manage on the bot rather\nthan Control: the check `PUT /bots/{id}/mode` authorizes with (S68).",
            "type": "boolean"
          },
          "updated_at": {
            "maxLength": 24,
            "type": "string"
          },
          "version": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          "visibility": {
            "$ref": "#/components/schemas/ModeVisibility",
            "description": "Who may see it."
          },
          "visibility_editable": {
            "description": "Whether the viewer may make it private if it's shared, or shared if\nit's private.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "visibility",
          "ownership",
          "editable",
          "deletable",
          "visibility_editable",
          "unlisted_command",
          "version",
          "created_at",
          "updated_at",
          "steps"
        ],
        "type": "object"
      },
      "ModeSchedule": {
        "description": "A step's schedule as its viewer sees it: its `type` and the fields that\ntype takes.",
        "properties": {
          "interval_ms": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "jitter_ms": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/ModeScheduleKind",
            "description": "When it runs."
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "ModeScheduleKind": {
        "description": "When a step runs: its schedule's `type` (ADR-0010).\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "at_start",
          "every",
          "on_respawn"
        ],
        "type": "string"
      },
      "ModeScheduleRequest": {
        "additionalProperties": false,
        "description": "A step's schedule in a request: its `type` and the fields that type\ntakes, no others (see `ModeScheduleKind`).",
        "properties": {
          "interval_ms": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "jitter_ms": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/ModeScheduleKind",
            "description": "When it runs."
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "ModeStep": {
        "description": "One step of a mode as its viewer may see it.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ModeAction",
            "description": "What it does."
          },
          "probability": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "schedule": {
            "$ref": "#/components/schemas/ModeSchedule",
            "description": "When it runs."
          }
        },
        "required": [
          "action",
          "schedule",
          "probability"
        ],
        "type": "object"
      },
      "ModeStepRequest": {
        "additionalProperties": false,
        "description": "One step of a mode in a request: what it does, when, and how likely.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ModeActionRequest",
            "description": "What it does."
          },
          "probability": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "schedule": {
            "$ref": "#/components/schemas/ModeScheduleRequest",
            "description": "When it runs."
          }
        },
        "required": [
          "action",
          "schedule",
          "probability"
        ],
        "type": "object"
      },
      "ModeVisibility": {
        "description": "Who may see a mode: its owner (and those who manage the owner's\naccounts: the Owner, and Admins for Members' modes), or everyone. A\nbuilt-in mode is shared.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "private",
          "shared"
        ],
        "type": "string"
      },
      "PasswordChangeRequest": {
        "additionalProperties": false,
        "description": "`POST /me/password`: a new password, after stepping up. Every other\nsession of the user ends, and so does this session's step-up.",
        "properties": {
          "new_password": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "new_password"
        ],
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/refresh`: a new token pair for the refresh token.",
        "properties": {
          "refresh_token": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "type": "object"
      },
      "RefusalReason": {
        "description": "Why Minecraft's side refused an account.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "not_owned",
          "no_profile",
          "xbox_banned",
          "xbox_no_xbox_profile",
          "xbox_country_unavailable",
          "xbox_adult_verification",
          "xbox_child_account",
          "xbox_other",
          "profile_mismatch"
        ],
        "type": "string"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/register`: an account from an invite. The invite decides\nthe role; the account has no 2FA until its first login's setup.",
        "properties": {
          "invite": {
            "maxLength": 64,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "type": "string"
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "invite",
          "username",
          "password"
        ],
        "type": "object"
      },
      "RegisterResponse": {
        "description": "The new account: log in with it next, and set up 2FA there.",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The role the invite gave."
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "SafeInt": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
      },
      "ServerSettingsPage": {
        "description": "`GET /server-settings`: one page of the servers' settings, newest first.",
        "properties": {
          "items": {
            "description": "The settings.",
            "items": {
              "$ref": "#/components/schemas/ServerSettingsResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ServerSettingsResponse": {
        "description": "One server's settings.",
        "properties": {
          "conflict_texts": {
            "description": "The conflict texts, in a fixed order, duplicates counted once.",
            "items": {
              "$ref": "#/components/schemas/ConflictTextResponse"
            },
            "type": "array"
          },
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "server": {
            "maxLength": 259,
            "type": "string"
          },
          "updated_at": {
            "maxLength": 24,
            "type": "string"
          },
          "version": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "server",
          "conflict_texts",
          "version",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "SessionPage": {
        "description": "`GET /me/sessions`: one page of live sessions, newest first.",
        "properties": {
          "items": {
            "description": "The sessions.",
            "items": {
              "$ref": "#/components/schemas/SessionResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "description": "A live session: not ended, and its refresh token not expired.",
        "properties": {
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "current": {
            "description": "Whether it's the session of this request.",
            "type": "boolean"
          },
          "expires_at": {
            "maxLength": 24,
            "type": "string"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "last_used_at": {
            "maxLength": 24,
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "last_used_at",
          "expires_at",
          "current"
        ],
        "type": "object"
      },
      "SessionServerFailure": {
        "description": "Why Mojang's session server couldn't confirm a join.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "unreachable",
          "rate_limited",
          "timed_out",
          "unexpected"
        ],
        "type": "string"
      },
      "StepUpRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/step-up`: the password again, which allows step-up actions\nin this session for 5 minutes.",
        "properties": {
          "password": {
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "description": "A session's tokens: the code step's and a refresh's answer.",
        "properties": {
          "access_expires_in": {
            "maximum": 3600,
            "minimum": 0,
            "type": "integer"
          },
          "access_token": {
            "maxLength": 64,
            "type": "string"
          },
          "refresh_expires_in": {
            "maximum": 31536000,
            "minimum": 0,
            "type": "integer"
          },
          "refresh_token": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "access_expires_in",
          "refresh_expires_in"
        ],
        "type": "object"
      },
      "UnplacedReason": {
        "description": "Why a bot runs nowhere.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "no_server",
          "stopped",
          "owner_disabled",
          "pending",
          "reauth_required",
          "refused",
          "offline_not_allowed",
          "awaiting_agent"
        ],
        "type": "string"
      },
      "UpdateModeRequest": {
        "additionalProperties": false,
        "description": "`PUT /modes/{id}`: the mode as it should be from now on, and the version\nthe caller last read (ADR-0020, S18, R2).",
        "properties": {
          "name": {
            "maxLength": 32,
            "type": "string"
          },
          "steps": {
            "description": "Its steps, at most 32, under `CreateModeRequest`'s rules.",
            "items": {
              "$ref": "#/components/schemas/ModeStepRequest"
            },
            "type": "array"
          },
          "version": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          "visibility": {
            "$ref": "#/components/schemas/ModeVisibility",
            "description": "Who may see it; switching needs the right to edit it both as it is\nand as it will be."
          }
        },
        "required": [
          "version",
          "name",
          "visibility",
          "steps"
        ],
        "type": "object"
      },
      "UpdateServerSettingsRequest": {
        "additionalProperties": false,
        "description": "`PUT /server-settings/{id}`: the settings as they should be from now on,\nand the version the caller last read (ADR-0020, S77).",
        "properties": {
          "conflict_texts": {
            "items": {
              "maxLength": 1024,
              "type": "string"
            },
            "type": "array"
          },
          "server": {
            "maxLength": 259,
            "type": "string"
          },
          "version": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "server",
          "conflict_texts"
        ],
        "type": "object"
      },
      "UserLabel": {
        "description": "A user named next to something else, such as an invite's creator.",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "type": "object"
      },
      "UserPage": {
        "description": "`GET /users`: one page of users, newest first.",
        "properties": {
          "items": {
            "description": "The users.",
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "UserPatchRequest": {
        "additionalProperties": false,
        "description": "`PATCH /users/{id}`: exactly one change, a role or `disabled`.",
        "properties": {
          "disabled": {
            "description": "Whether the user is disabled. Changing it, or the role, ends every\nsession of the user.",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The new role: `member` or `admin`, and only the Owner changes it."
          }
        },
        "type": "object"
      },
      "UserResponse": {
        "description": "A user as `GET /users` lists them, and as `PATCH /users/{id}` answers.",
        "properties": {
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "disabled": {
            "description": "Whether the user is disabled: they can't log in, and every request\nof theirs is refused.",
            "type": "boolean"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "last_seen_at": {
            "maxLength": 24,
            "type": "string"
          },
          "mfa_enrolled": {
            "description": "Whether the user has confirmed an authenticator. An invitee who never\nfinished the 2FA setup has none, and whoever first enrolls with their\npassword owns the account: disable such an account.",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The global role."
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "disabled",
          "created_at",
          "mfa_enrolled"
        ],
        "type": "object"
      },
      "UserRole": {
        "description": "A user's global role.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "member",
          "admin",
          "owner"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "access_token": {
        "scheme": "bearer",
        "type": "http"
      },
      "setup_token": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The afkfleet server's HTTP API. Served only in dev mode.",
    "license": {
      "identifier": "GPL-3.0-or-later",
      "name": "GPL-3.0-or-later"
    },
    "title": "afkfleet",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts": {
      "get": {
        "operationId": "list_accounts",
        "parameters": [
          {
            "description": "Only items older than this ID: the `next` of the page before.",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "maxLength": 36,
              "type": "string"
            }
          },
          {
            "description": "How many items at most; 50 by default.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPage"
                }
              }
            },
            "description": "One page of the accounts the caller may see, newest first: their own, those shared with them, every Member's for an Admin, and all of them for the Owner."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A query that doesn't parse."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid access token."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A `limit` outside 1 to 100."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again.",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "`GET /api/v1/accounts`: the accounts the caller may see, newest first.",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/v1/accounts/awaiting-approval": {
      "get": {
        "operationId": "accounts_awaiting_approval",
        "parameters": [
          {
            "description": "Only items older than this ID: the `next` of the page before.",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "maxLength": 36,
              "type": "string"
            }
          },
          {
            "description": "How many items at most; 50 by default.",
            "in": "query",
            "name": "limit",
