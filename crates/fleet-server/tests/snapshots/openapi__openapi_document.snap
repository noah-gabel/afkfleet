        "type": "object"
      },
      "MfaConfirmRequest": {
        "additionalProperties": false,
        "description": "`POST /me/mfa/confirm`: the first code the authenticator app shows, which\nproves it holds the secret.",
        "properties": {
          "code": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
