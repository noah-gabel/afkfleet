---
source: crates/fleet-server/tests/openapi.rs
expression: answer.json()
---
{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "What went wrong, for the caller.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "What went wrong."
          },
          "fields": {
            "description": "Every broken rule; only for `validation_failed`.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "message": {
            "maxLength": 256,
            "type": "string"
          },
          "request_id": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "What went wrong with a request.\nThis union lists the codes this version knows; a newer server may send\nothers, so code that branches on a code always keeps a default branch that\nshows the message and the request ID.",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "timeout",
          "conflict",
          "payload_too_large",
          "unsupported_media_type",
          "validation_failed",
          "rate_limited",
          "internal",
          "busy"
        ],
        "type": "string"
      },
      "ErrorResponse": {
        "description": "The body of every error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "The error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FieldError": {
        "description": "A field that broke a rule.",
        "properties": {
          "message": {
            "maxLength": 256,
            "type": "string"
          },
          "path": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The afkfleet server's HTTP API. Served only in dev mode.",
    "license": {
      "identifier": "GPL-3.0-or-later",
      "name": "GPL-3.0-or-later"
    },
    "title": "afkfleet",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live",
        "responses": {
          "200": {
            "description": "The server runs and answers requests. The body is empty."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "summary": "`GET /health/live`: the process runs and answers requests. It checks\nnothing else, so it never fails while the server can answer at all.",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "The database answers. The body is empty."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database failed; the server's log holds the cause under the request ID."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database is busy.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again: always 1.",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Any other answer the server gives, in the error envelope."
          }
        },
        "summary": "`GET /health/ready`: the server can serve requests, which means the\ndatabase answers.",
        "tags": [
          "health"
        ]
      }
    }
  }
}
