        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "`POST /auth/login`: the password step.",
        "properties": {
          "password": {
            "maxLength": 1024,
            "type": "string"
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
