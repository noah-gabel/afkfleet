---
source: crates/fleet-server/tests/openapi.rs
expression: answer.json()
---
{
  "components": {
    "schemas": {
      "AccountKind": {
        "description": "How an account signs in to Minecraft.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "microsoft",
          "offline"
        ],
        "type": "string"
      },
      "AccountLabel": {
        "description": "An account named by its ID and Minecraft name.",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "name": {
            "maxLength": 16,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "AccountPage": {
        "description": "One page of accounts, newest first.",
        "properties": {
          "items": {
            "description": "The accounts.",
            "items": {
              "$ref": "#/components/schemas/AccountResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "AccountResponse": {
        "description": "An account as `GET /accounts`, `GET /accounts/awaiting-approval` and\n`GET /accounts/{id}` show it to the caller, and as approving it answers.\nWho owns it is shown only to Admins, the Owner and whoever holds Manage\non it (ADR-0018, group E).",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AccountKind",
            "description": "How it signs in."
          },
          "level": {
            "$ref": "#/components/schemas/GrantLevel",
            "description": "What the caller may do with it: their own grant, or the Manage their\nrole or ownership gives them, whichever is higher."
          },
          "linked_at": {
            "maxLength": 24,
            "type": "string"
          },
          "name": {
            "maxLength": 16,
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/UserLabel",
            "description": "Who linked it, and so owns it: for Admins, the Owner and Manage only."
          },
          "reason": {
            "$ref": "#/components/schemas/RefusalReason",
            "description": "`refused`: why."
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus",
            "description": "Where it stands."
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "status",
          "level"
        ],
        "type": "object"
      },
      "AccountRestriction": {
        "description": "How Mojang refuses an account.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "banned",
          "multiplayer_disabled"
        ],
        "type": "string"
      },
      "AccountStatus": {
        "description": "Where a linked account stands.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "pending",
          "active",
          "reauth_required",
          "refused"
        ],
        "type": "string"
      },
      "AgentPage": {
        "description": "`GET /agents`: one page of agents, newest first.",
        "properties": {
          "items": {
            "description": "The agents.",
            "items": {
              "$ref": "#/components/schemas/AgentResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "AgentResponse": {
        "description": "An agent as `GET /agents` lists it, and as\n`POST /agents/{id}/disable` answers.",
        "properties": {
          "bots": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "capacity": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "connected_since": {
            "maxLength": 24,
            "type": "string"
          },
          "created_at": {
            "maxLength": 24,
            "type": "string"
          },
          "enabled": {
            "description": "Whether it's enabled; disabling is final.",
            "type": "boolean"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "last_seen_at": {
            "maxLength": 24,
            "type": "string"
          },
          "name": {
            "maxLength": 64,
            "type": "string"
          },
          "not_after": {
            "maxLength": 24,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AgentStatus",
            "description": "Its status."
          },
          "version": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "status",
          "bots",
          "created_at"
        ],
        "type": "object"
      },
      "AgentStatus": {
        "description": "An agent's status.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "online",
          "offline",
          "expired",
          "disabled"
        ],
        "type": "string"
      },
      "AuditActionName": {
        "description": "An audited action's name, as the audit log stores it. A newer server may record others, so code that branches on one always keeps a default branch.",
        "enum": [
          "user.create",
          "security.refresh_token_reuse",
          "security.lockout",
          "mfa.enroll",
          "mfa.reset",
          "auth.login",
          "auth.logout",
          "auth.step_up",
          "user.set_role",
          "user.set_disabled",
          "invite.create",
          "invite.revoke",
          "invite.use",
          "user.change_password",
          "session.revoke",
          "vault.rotate_key",
          "account.refresh",
          "account.set_status",
          "account.rename",
          "security.account_profile_mismatch",
          "account.start_link",
          "account.link",
          "account.approve",
          "account.refuse",
          "account.delete",
          "account.relink",
          "grant.create",
          "grant.set_level",
          "grant.revoke",
          "enrollment_token.create",
          "enrollment_token.use",
          "agent.enroll",
          "agent.connect",
          "agent.disconnect",
          "security.agent_identity_conflict",
          "agent.disable",
          "bot.assign",
          "bot.unassign",
          "bot.detach",
          "bot.stray",
          "agent.release",
          "bot.set_server",
          "bot.set_mode",
          "bot.start",
          "bot.stop",
          "bot.restart",
          "bot.reset",
          "bot.resume",
          "bot.send_chat",
          "bot.send_command",
          "mode.create",
          "mode.update",
          "mode.delete",
          "retention.purge",
          "server_settings.create",
          "server_settings.update",
          "server_settings.delete"
        ],
        "type": "string"
      },
      "AuditDetail": {
        "description": "One value of an audit entry's metadata, under its key: a text, an\ninteger or a flag, each the server's. A value only a newer server\nrecords comes as text.",
        "properties": {
          "flag": {
            "description": "A flag.",
            "type": "boolean"
          },
          "int": {
            "$ref": "#/components/schemas/SafeInt",
            "description": "An integer value: a count, a number or a row ID."
          },
          "key": {
            "maxLength": 32,
            "type": "string"
          },
          "text": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "type": "object"
      },
      "AuditEntryResponse": {
        "description": "One entry of the audit log, as `GET /audit` lists it.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/AuditActionName",
            "description": "What was done."
          },
          "actor": {
            "maxLength": 36,
            "type": "string"
          },
          "at": {
            "maxLength": 24,
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/SafeInt",
            "description": "The entry's ID, in commit order: the list's cursor."
          },
          "ip": {
            "maxLength": 45,
            "type": "string"
          },
          "metadata": {
            "description": "Its details, by key.",
            "items": {
              "$ref": "#/components/schemas/AuditDetail"
            },
            "type": "array"
          },
          "outcome": {
            "$ref": "#/components/schemas/AuditOutcomeName",
            "description": "How it ended."
          },
          "target": {
            "$ref": "#/components/schemas/AuditTargetResponse",
            "description": "What it touched, if anything."
          }
        },
        "required": [
          "id",
          "at",
          "action",
          "outcome",
          "metadata"
        ],
        "type": "object"
      },
      "AuditOutcomeName": {
        "description": "How an audited action ended.\nThis union lists the outcomes this version knows; a newer server may\nrecord others, so code that branches on one always keeps a default\nbranch.",
        "enum": [
          "success",
          "failure",
          "denied"
        ],
        "type": "string"
      },
      "AuditPage": {
        "description": "`GET /audit`: one page of the audit log, newest first.",
        "properties": {
          "items": {
            "description": "The entries.",
            "items": {
              "$ref": "#/components/schemas/AuditEntryResponse"
            },
            "type": "array"
          },
          "next": {
            "$ref": "#/components/schemas/SafeInt",
            "description": "The `before` of the next page, when one follows."
          },
          "unreadable": {
            "description": "The IDs of this page's entries that don't read back, newest first:\neach is still stored, and shown by its ID alone, in its place among\n`items` by ID; the server's log names why (ADR-0020, S52). Together\nwith `items`, at most the page's `limit`.",
            "items": {
              "$ref": "#/components/schemas/SafeInt"
            },
            "type": "array"
          }
        },
        "required": [
          "items",
          "unreadable"
        ],
        "type": "object"
      },
      "AuditTargetKind": {
        "description": "What an audit entry's target is.\nThis union lists the kinds this version knows; a newer server may\nrecord others, so code that branches on one always keeps a default\nbranch.",
        "enum": [
          "user",
          "account",
          "bot",
          "agent",
          "mode",
          "session",
          "invite",
          "enrollment_token",
          "server_settings"
        ],
        "type": "string"
      },
      "AuditTargetResponse": {
        "description": "What an audit entry touched.",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AuditTargetKind",
            "description": "What it is."
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "BotAgent": {
        "description": "The agent a bot is assigned to: for Admins and the Owner only.",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "name": {
            "maxLength": 64,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AgentStatus",
            "description": "Its status."
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "type": "object"
      },
      "BotModeRequest": {
        "additionalProperties": false,
        "description": "`PUT /bots/{id}/mode`: the mode the bot runs. Needs Control on the bot,\nor Manage when the mode sends a command off the allowlist, and the mode\nmust be one the caller may see.",
        "properties": {
          "mode_id": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "mode_id"
        ],
        "type": "object"
      },
      "BotPage": {
        "description": "`GET /bots`: one page of the bots the caller may see, newest first.",
        "properties": {
          "items": {
            "description": "The bots.",
            "items": {
              "$ref": "#/components/schemas/BotResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "BotPatchRequest": {
        "additionalProperties": false,
        "description": "`PATCH /bots/{id}`: the Minecraft server the bot joins. Needs Manage on\nthe bot and a step-up. Where the address points isn't checked here:\nthat's the agent's, on the address it resolves before it connects\n(ADR-0019, S46).",
        "properties": {
          "server_address": {
            "maxLength": 259,
            "type": "string"
          }
        },
        "required": [
          "server_address"
        ],
        "type": "object"
      },
      "BotResponse": {
        "description": "A bot as `GET /bots` and `GET /bots/{id}` show it to the caller, and as\nevery bot write answers.",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountResponse",
            "description": "Its account, as `GET /accounts/{id}` shows it to the caller: `level`\nsays what they may do with the bot."
          },
          "agent": {
            "$ref": "#/components/schemas/BotAgent",
            "description": "The agent it's assigned to: for Admins and the Owner only."
          },
          "desired_state": {
            "$ref": "#/components/schemas/DesiredState",
            "description": "Whether it should run."
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "mode_id": {
            "maxLength": 36,
            "type": "string"
          },
          "server_address": {
            "maxLength": 259,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BotStatus",
            "description": "What the server knows of its state."
          }
        },
        "required": [
          "id",
          "account",
          "mode_id",
          "desired_state",
          "status"
        ],
        "type": "object"
      },
      "BotStateKind": {
        "description": "A bot's lifecycle state (Plan.md Appendix E).\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "stopped",
          "awaiting_session",
          "connecting",
          "online",
          "backoff",
          "paused",
          "failed",
          "stopping"
        ],
        "type": "string"
      },
      "BotStateReason": {
        "description": "Why a bot is paused or failed.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "duplicate_login",
          "banned",
          "not_whitelisted",
          "wrong_version",
          "account_banned",
          "multiplayer_disabled",
          "auth",
          "session_denied",
          "crash_loop"
        ],
        "type": "string"
      },
      "BotStatus": {
        "description": "What the server knows of a bot's state when it answers (ADR-0019, S41).\n`kind` says which of the other fields are there:\n- `reported`: `state` (with `reason` when paused or failed) and `since`,\n  when it entered it; `online_since` while online, `attempt` while it\n  tries, `restarting` while stopping, and `last_disconnect`.\n- `awaiting_report`: `since`, when the wait began.\n- `unknown`: `agent_last_seen_at`, and the last known `state` (with\n  `reason`) and `since`, when the server received it.\n- `unplaced`: `why`, and `state`: `paused` or `failed` (with `reason`)\n  when it rests there, otherwise `stopped`.",
        "properties": {
          "agent_last_seen_at": {
            "maxLength": 24,
            "type": "string"
          },
          "attempt": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/BotStatusKind",
            "description": "What the status rests on."
          },
          "last_disconnect": {
            "$ref": "#/components/schemas/LastDisconnect",
            "description": "How its last session ended."
          },
          "online_since": {
            "maxLength": 24,
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/BotStateReason",
            "description": "Why it's paused or failed."
          },
          "restarting": {
            "description": "While stopping: whether it starts again once it has left.",
            "type": "boolean"
          },
          "since": {
            "maxLength": 24,
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/BotStateKind",
            "description": "The state."
          },
          "why": {
            "$ref": "#/components/schemas/UnplacedReason",
            "description": "`unplaced`: why."
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "BotStatusKind": {
        "description": "What a bot's status rests on.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "reported",
          "awaiting_report",
          "unknown",
          "unplaced"
        ],
        "type": "string"
      },
      "ChangeGrantRequest": {
        "additionalProperties": false,
        "description": "`PUT /accounts/{id}/grants/{user}`: change the user's grant.",
        "properties": {
          "level": {
            "$ref": "#/components/schemas/GrantLevel",
            "description": "What they may do with it from now on."
          }
        },
        "required": [
          "level"
        ],
        "type": "object"
      },
      "ChatCommandRequest": {
        "additionalProperties": false,
        "description": "`POST /bots/{id}/command`: a command for the bot to send, after a\nstep-up.",
        "properties": {
          "message": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ChatDirection": {
        "description": "Whether a bot received a line or sent it.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "in",
          "out"
        ],
        "type": "string"
      },
      "ChatFailure": {
        "description": "Why a line its bot didn't send failed, as a live `chat_failed` event says\nit to viewers with Control or more (ADR-0020, S34): the same four codes\n`POST /bots/{id}/chat` answers a failure with, by their error codes'\nnames.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "bot_not_online",
          "chat_unavailable",
          "rate_limited",
          "bot_unreachable"
        ],
        "type": "string"
      },
      "ChatLine": {
        "description": "One line of a bot's chat, as its viewer may see it (S6, S9, U3).",
        "properties": {
          "arguments_hidden": {
            "description": "Whether a command's arguments were left out for this viewer (S9).",
            "type": "boolean"
          },
          "at": {
            "maxLength": 24,
            "type": "string"
          },
          "direction": {
            "$ref": "#/components/schemas/ChatDirection",
            "description": "Received or sent."
          },
          "id": {
            "$ref": "#/components/schemas/SafeInt",
            "description": "The line's ID, the history's cursor: a newer line has a greater one.\nThe order is the server's commit order, which a user's line can lead\nby a moment (ADR-0020, U5)."
          },
          "kind": {
            "$ref": "#/components/schemas/ChatLineKind",
            "description": "What kind of line it is."
          },
          "mine": {
            "description": "Whether the viewer had this line sent (U3).",
            "type": "boolean"
          },
          "sender": {
            "$ref": "#/components/schemas/ChatLineSender",
            "description": "Who sent a received player message, as the Minecraft server claims."
          },
          "sent_by": {
            "$ref": "#/components/schemas/UserLabel",
            "description": "Who had a user's line sent: for viewers who see the account's owner,\nand only while that user exists (U3)."
          },
          "text": {
            "maxLength": 3072,
            "type": "string"
          },
          "truncated": {
            "description": "Whether a received text was cut where it was stored.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "at",
          "direction",
          "kind",
          "text",
          "truncated",
          "arguments_hidden",
          "mine"
        ],
        "type": "object"
      },
      "ChatLineKind": {
        "description": "What kind of line it is: what a bot received, as its Minecraft server\nsent it, or who had it sent.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "chat",
          "emote",
          "whisper",
          "announcement",
          "system",
          "mode",
          "user"
        ],
        "type": "string"
      },
      "ChatLineSender": {
        "description": "Who sent a received line, as its Minecraft server claims it: never\nverified (ADR-0011).",
        "properties": {
          "name": {
            "maxLength": 64,
            "type": "string"
          },
          "uuid": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ChatPage": {
        "description": "`GET /bots/{id}/chat`: one page of a bot's chat, newest first.",
        "properties": {
          "items": {
            "description": "The lines.",
            "items": {
              "$ref": "#/components/schemas/ChatLine"
            },
            "type": "array"
          },
          "next": {
            "$ref": "#/components/schemas/SafeInt",
            "description": "The `before` of the next page, when one follows."
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ChatSendOutcome": {
        "description": "What came of a line the server sent to its bot's agent.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "sent",
          "pending"
        ],
        "type": "string"
      },
      "ChatSendRequest": {
        "additionalProperties": false,
        "description": "`POST /bots/{id}/chat`: a line for the bot to send, plain chat or a\ncommand on the server's allowlist.",
        "properties": {
          "message": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ChatSendResponse": {
        "description": "The answer to a line that went to its bot's agent.",
        "properties": {
          "message_id": {
            "$ref": "#/components/schemas/SafeInt",
            "description": "The line's ID in the bot's chat history."
          },
          "outcome": {
            "$ref": "#/components/schemas/ChatSendOutcome",
            "description": "What came of it."
          },
          "request_id": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "message_id",
          "outcome"
        ],
        "type": "object"
      },
      "ConflictTextResponse": {
        "description": "One conflict text in an answer: its lines, in order.",
        "properties": {
          "lines": {
            "items": {
              "maxLength": 1024,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "lines"
        ],
        "type": "object"
      },
      "ConnectFailure": {
        "description": "Why a bot couldn't connect.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "refused",
          "timed_out",
          "unresolvable",
          "host_unavailable",
          "other",
          "blocked"
        ],
        "type": "string"
      },
      "CreateGrantRequest": {
        "additionalProperties": false,
        "description": "`POST /accounts/{id}/grants`: share the account with the user named\n`username`. Every name that can't be granted gets the same answer, so it\ntells nothing about which users exist.",
        "properties": {
          "level": {
            "$ref": "#/components/schemas/GrantLevel",
            "description": "What they may do with it."
          },
          "username": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "username",
          "level"
        ],
        "type": "object"
      },
      "CreateInviteRequest": {
        "additionalProperties": false,
        "description": "`POST /invites`: a new invite for `role`.",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The role the new user gets: `member` (Admins and the Owner) or\n`admin` (the Owner only)."
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "CreateModeRequest": {
        "additionalProperties": false,
        "description": "`POST /modes`: a new mode, the caller's own.",
        "properties": {
          "name": {
            "maxLength": 32,
            "type": "string"
          },
          "steps": {
            "description": "Its steps, at most 32, in the order they run when due together.",
            "items": {
              "$ref": "#/components/schemas/ModeStepRequest"
            },
            "type": "array"
          },
          "visibility": {
            "$ref": "#/components/schemas/ModeVisibility",
            "description": "Who may see it; a shared mode needs an Admin or the Owner."
          }
        },
        "required": [
          "name",
          "visibility",
          "steps"
        ],
        "type": "object"
      },
      "CreateOfflineAccountRequest": {
        "additionalProperties": false,
        "description": "`POST /accounts/offline`: an offline account named `name`, while the\nserver allows them (`[accounts] allow_offline`).",
        "properties": {
          "name": {
            "maxLength": 16,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateServerSettingsRequest": {
        "additionalProperties": false,
        "description": "`POST /server-settings`: a server's new settings.",
        "properties": {
          "conflict_texts": {
            "items": {
              "maxLength": 1024,
              "type": "string"
            },
            "type": "array"
          },
          "server": {
            "maxLength": 259,
            "type": "string"
          }
        },
        "required": [
          "server",
          "conflict_texts"
        ],
        "type": "object"
      },
      "CreatedEnrollmentTokenResponse": {
        "description": "`POST /agents/enrollment-tokens`: the new token, in its bundle, shown\nthis once.",
        "properties": {
          "bundle": {
            "maxLength": 146,
            "type": "string"
          },
          "ca_fingerprint": {
            "maxLength": 95,
            "type": "string"
          },
          "expires_at": {
            "maxLength": 24,
            "type": "string"
          },
          "id": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "id",
          "bundle",
          "ca_fingerprint",
          "expires_at"
        ],
        "type": "object"
      },
      "CreatedInviteResponse": {
        "description": "The new invite, with its code: shown this once.",
        "properties": {
          "code": {
            "maxLength": 64,
            "type": "string"
          },
          "invite": {
            "$ref": "#/components/schemas/InviteResponse",
            "description": "The invite as `GET /invites` lists it."
          }
        },
        "required": [
          "code",
          "invite"
        ],
        "type": "object"
      },
      "CreatedOfflineAccountResponse": {
        "description": "The new offline account.",
        "properties": {
          "id": {
            "maxLength": 36,
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AccountKind",
            "description": "`offline`."
          },
          "name": {
            "maxLength": 16,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus",
            "description": "`active`: an offline account needs no approval."
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "status"
        ],
        "type": "object"
      },
      "DesiredState": {
        "description": "Whether a bot should run.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "running",
          "stopped"
        ],
        "type": "string"
      },
      "DisconnectKind": {
        "description": "How a bot's last session ended.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "kicked",
          "connection_closed",
          "connect_failed",
          "auth_rejected",
          "account_restricted",
          "session_server_failed",
          "session_crashed",
          "watchdog_timeout",
          "liveness_timeout",
          "respawn_failed"
        ],
        "type": "string"
      },
      "ErrorBody": {
        "description": "What went wrong, for the caller.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "What went wrong."
          },
          "fields": {
            "description": "Every broken rule; only for `validation_failed`.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "message": {
            "maxLength": 256,
            "type": "string"
          },
          "request_id": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "What went wrong with a request.\nThis union lists the codes this version knows; a newer server may send\nothers, so code that branches on a code always keeps a default branch that\nshows the message and the request ID.",
        "enum": [
          "bad_request",
          "unauthorized",
          "invalid_credentials",
          "forbidden",
          "step_up_required",
          "not_found",
          "method_not_allowed",
          "timeout",
          "conflict",
          "payload_too_large",
          "unsupported_media_type",
          "validation_failed",
          "rate_limited",
          "internal",
          "busy",
          "bot_unreachable",
          "bot_not_running",
          "bot_not_paused",
          "bot_not_failed",
          "bot_not_online",
          "chat_unavailable",
          "command_needs_step_up",
          "mode_needs_step_up",
          "mode_changed",
          "mode_in_use_by_others",
          "mode_in_use",
          "too_many_connections",
          "agent_not_disabled",
          "server_settings_changed"
        ],
        "type": "string"
      },
      "ErrorResponse": {
        "description": "The body of every error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "The error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "EventMessage": {
        "description": "One frame of the live events socket: what happened, by its `type`. The\n`events` module's docs say which frames come, which fields each kind\nalways carries, and how a client reads one. Every field but `type` is\nleft out where its kind doesn't carry it.",
        "properties": {
          "at": {
            "maxLength": 24,
            "type": "string"
          },
          "bot": {
            "$ref": "#/components/schemas/BotResponse",
            "description": "`bot`: the bot as the viewer's `GET /bots/{id}` shows it now."
          },
          "bot_id": {
            "maxLength": 36,
            "type": "string"
          },
          "failure": {
            "$ref": "#/components/schemas/ChatFailure",
            "description": "`chat_failed`, for viewers with Control or more, when the server\nknows it: why the line failed."
          },
          "line": {
            "$ref": "#/components/schemas/ChatLine",
            "description": "`chat`: the line as the viewer's history shows it."
          },
          "mode": {
            "$ref": "#/components/schemas/ModeResponse",
            "description": "`mode`: the mode as the viewer's `GET /modes` lists it now."
          },
          "mode_id": {
            "maxLength": 36,
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/BotStateReason",
            "description": "`bot_alert`: why it rests there."
          },
          "request": {
            "maxLength": 36,
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/BotStateKind",
            "description": "`bot_alert`: the state the bot rests in, `paused` or `failed`."
          },
          "type": {
            "$ref": "#/components/schemas/EventMessageKind",
            "description": "What happened."
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "EventMessageKind": {
        "description": "What an `EventMessage` says.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on one always keeps a default branch.",
        "enum": [
          "ready",
          "resync",
          "bot",
          "bot_removed",
          "bot_died",
          "bot_alert",
          "chat",
          "chat_sent",
          "chat_failed",
          "mode",
          "mode_removed"
        ],
        "type": "string"
      },
      "EventTicketResponse": {
        "description": "`POST /events/ticket`: a ticket for one live events socket.",
        "properties": {
          "expires_in": {
            "maximum": 30,
            "minimum": 0,
            "type": "integer"
          },
          "ticket": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "expires_in"
        ],
        "type": "object"
      },
      "FailedCodeAttempts": {
        "description": "The wrong 2FA codes typed for the user after their previous successful\nlogin: what happened since they last logged in. The wrong codes of the\nnewest login's own step, the user's typos before it succeeded, aren't\ncounted, so a count above 0 means a login step that never succeeded.",
        "properties": {
          "count": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "last_at": {
            "maxLength": 24,
            "type": "string"
          }
        },
        "required": [
          "count"
        ],
        "type": "object"
      },
      "FieldError": {
        "description": "A field that broke a rule.",
        "properties": {
          "message": {
            "maxLength": 256,
            "type": "string"
          },
          "path": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "type": "object"
      },
      "GrantLevel": {
        "description": "What a user may do with an account (Plan.md §7.3): `view` < `control` <\n`manage`.\nThis union lists the values this version knows; a newer server may send\nothers, so code that branches on it keeps a default branch.",
        "enum": [
          "view",
          "control",
          "manage"
        ],
        "type": "string"
      },
      "GrantPage": {
        "description": "`GET /accounts/{id}/grants`: one page of grants, newest grantee first.",
        "properties": {
          "items": {
            "description": "The grants.",
            "items": {
              "$ref": "#/components/schemas/GrantResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "GrantResponse": {
        "description": "A grant as `GET /accounts/{id}/grants` lists it, and as creating or\nchanging one answers.",
        "properties": {
          "granted_at": {
            "maxLength": 24,
            "type": "string"
          },
          "granted_by": {
            "$ref": "#/components/schemas/UserLabel",
            "description": "Who set it last."
          },
          "level": {
            "$ref": "#/components/schemas/GrantLevel",
            "description": "What it allows."
          },
          "user": {
            "$ref": "#/components/schemas/UserLabel",
            "description": "Who it's for."
          }
        },
        "required": [
          "user",
          "level",
          "granted_by",
          "granted_at"
        ],
        "type": "object"
      },
      "HeldGrantPage": {
        "description": "`GET /users/{id}/grants`: one page of the grants a user holds, newest\naccount first.",
        "properties": {
          "items": {
            "description": "The grants.",
            "items": {
              "$ref": "#/components/schemas/HeldGrantResponse"
            },
            "type": "array"
          },
          "next": {
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "HeldGrantResponse": {
        "description": "A grant a user holds, as `GET /users/{id}/grants` lists it: the review\nat a role change (the Owner's; ADR-0020, S50).",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountLabel",
            "description": "The account it shares."
          },
          "dormant": {
            "description": "Whether it's dormant: the user's role gives Manage on the account\nnow, so the grant adds nothing, and it counts again after a demotion.",
            "type": "boolean"
