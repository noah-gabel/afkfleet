{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window. It grants exactly the app's own commands, each by its allow-<command> permission, and no core or plugin permission (ADR-0017).",
  "windows": ["main"],
  "permissions": [
    "allow-server-profile",
    "allow-set-server-profile",
    "allow-check-server",
    "allow-login",
    "allow-login-mfa",
    "allow-logout",
    "allow-register",
    "allow-step-up",
    "allow-mfa-enroll",
    "allow-mfa-confirm",
    "allow-mfa-reset",
    "allow-me",
    "allow-change-password",
    "allow-sessions",
    "allow-revoke-session",
    "allow-users",
    "allow-patch-user",
    "allow-invites",
    "allow-create-invite",
    "allow-revoke-invite",
    "allow-start-link",
    "allow-link-status",
    "allow-create-offline-account",
    "allow-accounts",
    "allow-accounts-awaiting-approval",
    "allow-account",
    "allow-delete-account",
    "allow-approve-account",
    "allow-refuse-account",
    "allow-relink-account",
    "allow-account-grants",
    "allow-create-grant",
    "allow-change-grant",
    "allow-revoke-grant",
    "allow-open-verification-link",
    "allow-watch-events",
    "allow-bots",
    "allow-bot",
    "allow-modes",
    "allow-patch-bot",
    "allow-set-bot-mode",
    "allow-start-bot",
    "allow-stop-bot",
    "allow-restart-bot",
    "allow-reset-bot",
    "allow-resume-bot",
    "allow-bot-chat",
    "allow-send-chat",
    "allow-send-command",
    "allow-server-settings",
    "allow-create-server-settings",
    "allow-update-server-settings",
    "allow-delete-server-settings"
  ]
}
