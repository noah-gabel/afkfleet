{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "afkfleet",
  "identifier": "io.github.noah-gabel.afkfleet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "afkfleet",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": true,
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQzZDRUIyNUY5RjJDQjAKUldTd0xKOWZzczdHMHZGQWVwOUtWMGk2bVMvakdOSkM4aFFCcGJiSGExNjRNclFYeFNxemlHVDIK",
      "endpoints": ["https://github.com/noah-gabel/afkfleet/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "publisher": "afkfleet",
    "copyright": "The afkfleet contributors. GPL-3.0-or-later.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
