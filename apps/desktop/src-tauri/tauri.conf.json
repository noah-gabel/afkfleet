{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "afkfleet",
  "identifier": "io.github.noah-gabel.afkfleet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "afkfleet",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
