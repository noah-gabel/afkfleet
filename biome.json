{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!packages/ui/src/generated", "!**/.sqlx"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "packages/ui never knows the platform: the desktop app injects its ApiClient (CLAUDE.md, ADR-0017)."
                  },
                  {
                    "group": ["zod", "zod/**"],
                    "message": "Import z from src/api/zod.ts, which sets zod jitless before any schema exists: its JIT probe evaluates code, which the release CSP blocks and reports (ADR-0017)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/api/zod.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "packages/ui never knows the platform: the desktop app injects its ApiClient (CLAUDE.md, ADR-0017)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/**", "!@tauri-apps/api/core"],
                    "message": "The desktop app uses only @tauri-apps/api/core (invoke, and Channel for the live events); any other Tauri API needs a capability grant and an ADR (ADR-0017)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/**", "!@tauri-apps/api/core"],
                    "message": "The desktop app uses only @tauri-apps/api/core (invoke, and Channel for the live events); any other Tauri API needs a capability grant and an ADR (ADR-0017)."
                  },
                  {
                    "group": ["**/e2e", "**/e2e/**"],
                    "message": "The shipped app never imports the e2e build, whose invoke sends commands over HTTP (Plan.md P8.9, ADR-0017)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
