{
  "permissions": {
    "allow": [
      "Bash(git push -u origin p*)",
      "PowerShell(git push -u origin p*)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(gh pr checks *)",
      "PowerShell(gh pr checks *)",
      "Bash(gh pr diff *)",
      "PowerShell(gh pr diff *)",
      "Bash(gh pr edit *)",
      "PowerShell(gh pr edit *)",
      "Bash(gh run list *)",
      "PowerShell(gh run list *)",
      "Bash(gh run view *)",
      "PowerShell(gh run view *)",
      "Bash(gh pr merge * --squash --match-head-commit *)",
      "PowerShell(gh pr merge * --squash --match-head-commit *)"
    ],
    "ask": [
      "Bash(gh pr edit *--add-label*)",
      "PowerShell(gh pr edit *--add-label*)",
      "Bash(gh pr edit *--add-reviewer*)",
      "PowerShell(gh pr edit *--add-reviewer*)",
      "Bash(gh pr edit *--add-assignee*)",
      "PowerShell(gh pr edit *--add-assignee*)",
      "Bash(gh pr edit *--add-project*)",
      "PowerShell(gh pr edit *--add-project*)",
      "Bash(gh pr edit *--milestone*)",
      "PowerShell(gh pr edit *--milestone*)",
      "Bash(gh pr edit *--base*)",
      "PowerShell(gh pr edit *--base*)",
      "Bash(gh pr comment *)",
      "PowerShell(gh pr comment *)",
      "Bash(gh pr review *)",
      "PowerShell(gh pr review *)",
      "Bash(gh pr close *)",
      "PowerShell(gh pr close *)",
      "Bash(gh pr reopen *)",
      "PowerShell(gh pr reopen *)",
      "Bash(gh pr ready *)",
      "PowerShell(gh pr ready *)",
      "Bash(gh pr lock *)",
      "PowerShell(gh pr lock *)",
      "Bash(gh pr unlock *)",
      "PowerShell(gh pr unlock *)",
      "Bash(gh pr update-branch *)",
      "PowerShell(gh pr update-branch *)",
      "Bash(gh pr revert *)",
      "PowerShell(gh pr revert *)",
      "Bash(gh issue *)",
      "PowerShell(gh issue *)",
      "Bash(gh label *)",
      "PowerShell(gh label *)",
      "Bash(gh release *)",
      "PowerShell(gh release *)",
      "Bash(gh repo *)",
      "PowerShell(gh repo *)",
      "Bash(gh workflow *)",
      "PowerShell(gh workflow *)",
      "Bash(gh secret *)",
      "PowerShell(gh secret *)",
      "Bash(gh variable *)",
      "PowerShell(gh variable *)",
      "Bash(gh auth *)",
      "PowerShell(gh auth *)",
      "Bash(gh gist *)",
      "PowerShell(gh gist *)",
      "Bash(gh alias *)",
      "PowerShell(gh alias *)",
      "Bash(gh extension *)",
      "PowerShell(gh extension *)",
      "Bash(gh cache *)",
      "PowerShell(gh cache *)",
      "Bash(gh project *)",
      "PowerShell(gh project *)",
      "Bash(gh run rerun *)",
      "PowerShell(gh run rerun *)",
      "Bash(gh run cancel *)",
      "PowerShell(gh run cancel *)",
      "Bash(gh run delete *)",
      "PowerShell(gh run delete *)"
    ],
    "deny": [
      "Bash(git push * main*)",
      "PowerShell(git push * main*)",
      "Bash(git push *:main*)",
      "PowerShell(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "PowerShell(git push *refs/heads/main*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push *--force*)",
      "PowerShell(git push *--force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git push *+*)",
      "PowerShell(git push *+*)",
      "Bash(gh pr merge * --admin*)",
      "PowerShell(gh pr merge * --admin*)",
      "Bash(gh pr merge *--admin*)",
      "PowerShell(gh pr merge *--admin*)",
      "Bash(gh pr merge * --auto*)",
      "PowerShell(gh pr merge * --auto*)",
      "Bash(gh pr merge *--auto*)",
      "PowerShell(gh pr merge *--auto*)",
      "Bash(gh api *)",
      "PowerShell(gh api *)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/merge-guard.mjs"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
