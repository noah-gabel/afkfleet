{
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(*secrets/*)",
      "PowerShell(*secrets/*)",
      "Bash(*target/dod-run*)",
      "PowerShell(*target/dod-run*)",
      "Bash(*vault-key-*)",
      "PowerShell(*vault-key-*)",
      "Bash(gh auth*)",
      "PowerShell(gh auth*)",
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(git push * main*)",
      "PowerShell(git push * main*)",
      "Bash(git push *:main*)",
      "PowerShell(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "PowerShell(git push *refs/heads/main*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push *--force*)",
      "PowerShell(git push *--force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git push *+*)",
      "PowerShell(git push *+*)",
      "Bash(git push *--tags*)",
      "PowerShell(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "PowerShell(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "PowerShell(git push *refs/tags/*)",
      "Bash(git push * v*)",
      "PowerShell(git push * v*)",
      "Bash(gh release*)",
      "PowerShell(gh release*)",
      "Bash(gh repo*)",
      "PowerShell(gh repo*)",
      "Bash(gh secret*)",
      "PowerShell(gh secret*)",
      "Bash(gh variable*)",
      "PowerShell(gh variable*)",
      "Bash(gh ruleset*)",
      "PowerShell(gh ruleset*)",
      "Bash(gh workflow enable*)",
      "PowerShell(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "PowerShell(gh workflow disable*)",
      "Bash(gh api * -X*)",
      "PowerShell(gh api * -X*)",
      "Bash(gh api *--method*)",
      "PowerShell(gh api *--method*)",
      "Bash(gh api * -f *)",
      "PowerShell(gh api * -f *)",
      "Bash(gh api * -F *)",
      "PowerShell(gh api * -F *)",
      "Bash(gh api *--field*)",
      "PowerShell(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "PowerShell(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "PowerShell(gh api *--input*)",
      "Bash(just test-real-account*)",
      "PowerShell(just test-real-account*)",
      "Bash(just test-ms-account*)",
      "PowerShell(just test-ms-account*)",
      "Bash(just test-managed-account*)",
      "PowerShell(just test-managed-account*)",
      "Bash(just dod-*)",
      "PowerShell(just dod-*)",
      "Bash(just updater-sign*)",
      "PowerShell(just updater-sign*)",
      "Bash(*--profile manual*)",
      "PowerShell(*--profile manual*)",
      "Bash(*-P manual*)",
      "PowerShell(*-P manual*)",
      "Bash(gh codespace*)",
      "PowerShell(gh codespace*)",
      "Read(/secrets/**)",
      "Edit(/secrets/**)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/vault-key-*)",
      "Edit(**/vault-key-*)",
      "Read(/target/dod-run/**)",
      "Edit(/target/dod-run/**)"
